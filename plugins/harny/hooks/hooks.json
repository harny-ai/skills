{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_PLUGIN_OPTION_HARNY_APP_KEY\" ] && [ -n \"$CLAUDE_ENV_FILE\" ] && printf 'export HARNY_API_KEY=%s\\n' \"$CLAUDE_PLUGIN_OPTION_HARNY_APP_KEY\" >> \"$CLAUDE_ENV_FILE\"; exit 0",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
